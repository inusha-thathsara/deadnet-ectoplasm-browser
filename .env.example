# ==============================================================================
# DEADNET ECTOPLASM BROWSER — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Several partners provide free credits & promo codes at: https://hacktoberfest.com/my
# Fill in the keys below to unlock live cloud integrations for Hacktoberfest Week 4.
# ==============================================================================

# 1. HISTORICAL SEARCH & GROUNDING (Best Use of SerpApi — $100 Prize Track)
# Used to search Reddit, USENET, and vintage forum records to ground dead links in facts.
# Get your free key at: https://serpapi.com/
SERPAPI_API_KEY=

# 2. HEADLESS CLOUD BROWSER (Best Use of Browserbase — $100 Prize Track)
# Used by Stagehand v4 to load raw archival DOMs and extract broken element pathologies.
# Claim free credits at: https://www.browserbase.com/
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# 3. OPEN-WEIGHT AI (Featured Category: Best Use of Gemma — $200 Prize Track)
# By default, DeadNet connects to local Ollama on your machine (http://localhost:11434).
# Model recommendations: "gemma2:9b" or "gemma:2b".
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:9b

# (Optional Cloud Open-Weight Fallback if local Ollama is not running)
OPENROUTER_API_KEY=

# 4. OBSERVABILITY & AGENT TRACING (Best Use of Sentry Agent Tracing — $100 Track)
# Instruments Gemma LLM token throughput, Stagehand latency, and workflow spans.
# Get free project DSN at: https://sentry.io/
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# 5. DURABLE WORKFLOW ORCHESTRATION (Best Use of Temporal — $100 Prize Track)
# Wraps archive retrievals in resilient retries against HTTP 429 timeouts.
# Default connects to local Temporal server or Temporal Cloud namespace.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# 6. OPTIONAL EERIE SYNTHESIZED VOICE (Best Use of ElevenLabs — $100 Prize Track)
# Whispers reconstructed webmaster comments through speakers.
# Claim free credits at: https://elevenlabs.io/
ELEVENLABS_API_KEY=
