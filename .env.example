# ==============================================================================
# DEADNET ECTOPLASM BROWSER — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Configure the API keys below to unlock cloud integrations and live services.
# ==============================================================================

# 1. HISTORICAL SEARCH & GROUNDING (SerpApi)
# Used to search Reddit, USENET, and vintage forum records to ground dead links in facts.
# Get your key at: https://serpapi.com/
SERPAPI_API_KEY=

# 2. HEADLESS CLOUD BROWSER (Browserbase + Stagehand v4)
# Used by Stagehand to load raw archival DOMs and extract broken element pathologies.
# Get your key at: https://www.browserbase.com/
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# 3. OPEN-WEIGHT AI (Gemma 2 / Gemma 3)
# By default, DeadNet connects to local Ollama on your machine (http://localhost:11434).
# Model recommendations: "gemma2:9b" or "gemma:2b".
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:9b

# (Optional Cloud Open-Weight Fallback if local Ollama is not running)
OPENROUTER_API_KEY=

# 4. OBSERVABILITY & AGENT TRACING (Sentry)
# Instruments Gemma LLM token throughput, Stagehand latency, and workflow spans.
# Get project DSN at: https://sentry.io/
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# 5. DURABLE WORKFLOW ORCHESTRATION (Temporal)
# Wraps archive retrievals in resilient retries against HTTP 429 timeouts.
# Default connects to local Temporal server or Temporal Cloud namespace.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# 6. OPTIONAL SYNTHESIZED VOICE (ElevenLabs)
# Whispers reconstructed webmaster comments through speakers.
# Get key at: https://elevenlabs.io/
ELEVENLABS_API_KEY=
